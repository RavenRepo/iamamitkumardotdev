# ============================================
# Environment Variables Template
# ============================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env or .env.local to version control.
# ============================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Server-side)
PROJECT_URL=https://your-project.supabase.co
ANON_KEY=your-anon-key-here
SERVICE_ROLE=your-service-role-key-here

# Supabase (Client-side, exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
NEXT_PUBLIC_PROJECT_URL=https://your-project.supabase.co
NEXT_PUBLIC_ANON_KEY=your-anon-key-here

# PostgreSQL (Direct connection for claps)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis (Rate limiting - optional but recommended for production)
REDIS_URL=redis://localhost:6379

# Notion Integration
NOTION_INTEGRATION_SECRET=your-notion-integration-secret
NOTION_PARENT_PAGE_ID=your-notion-parent-page-id
NOTION_PROJECTS_DB_ID=your-notion-projects-db-id
NOTION_CONTENT_CALENDAR_DB_ID=your-notion-content-calendar-db-id
NOTION_SOPS_DB_ID=your-notion-sops-db-id
NOTION_REVIEW_PARENT_PAGE_ID=your-notion-review-parent-page-id
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_OAUTHCLIENT_SECRET=your-notion-oauth-client-secret
NOTION_WEBHOOK_SECRET=your-notion-webhook-secret
NOTION_REDIRECT_URI=https://your-domain.com/api/notion/oauth/callback

# Typefully
TYPEFULLY_CLIENT_ID=your-typefully-client-id
TYPEFULLY_CLIENT_SECRET=your-typefully-client-secret
TYPEFULLY_WEBHOOK_SECRET=your-typefully-webhook-secret
TYPEFULLY_REDIRECT_URI=https://your-domain.com/api/typefully/oauth/callback
TYPEFULLY_BASE_URL=https://api.typefully.com
TYPEFULLY_API_KEY=your-typefully-api-key

# Mixpanel Analytics
NEXT_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token

# OpenClaw (Optional)
OPENCLAW_API_KEY=your-openclaw-api-key

# Admin Access (comma-separated Supabase user IDs)
ADMIN_USER_IDS=user-id-1,user-id-2

# Analytics (Optional - Plausible)
NEXT_PUBLIC_ANALYTICS_DOMAIN=your-domain
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=your-script-url
